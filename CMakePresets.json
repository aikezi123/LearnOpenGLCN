{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-msvc-x64",
      "description": "MSVC x64 共享配置：启用 vcpkg 工具链，并选用动态 MSVC 运行库配合静态第三方库的 triplet。",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "ninja-msvc-debug",
      "displayName": "Ninja + MSVC Debug",
      "description": "使用 Ninja 和 MSVC 生成 Debug 构建目录，同时导出 compile_commands.json。",
      "inherits": "vcpkg-msvc-x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "ninja-msvc-release",
      "displayName": "Ninja + MSVC Release",
      "description": "使用 Ninja 和 MSVC 生成启用优化的 Release 构建目录。",
      "inherits": "vcpkg-msvc-x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "ninja-msvc-asan",
      "displayName": "Ninja + MSVC AddressSanitizer",
      "description": "继承 Debug 配置并启用 AddressSanitizer，用于检查内存错误。",
      "inherits": "ninja-msvc-debug",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "ENGINEERINGLAB_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-msvc-debug",
      "description": "构建 ninja-msvc-debug 配置。",
      "configurePreset": "ninja-msvc-debug"
    },
    {
      "name": "ninja-msvc-release",
      "description": "构建 ninja-msvc-release 配置。",
      "configurePreset": "ninja-msvc-release"
    },
    {
      "name": "ninja-msvc-asan",
      "description": "构建 ninja-msvc-asan 配置。",
      "configurePreset": "ninja-msvc-asan"
    }
  ],
  "testPresets": [
    {
      "name": "ninja-msvc-debug",
      "displayName": "Ninja + MSVC Debug Tests",
      "description": "运行 Debug 构建目录中由 CTest 注册的全部测试。",
      "configurePreset": "ninja-msvc-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ninja-msvc-release",
      "displayName": "Ninja + MSVC Release Tests",
      "description": "运行 Release 构建目录中由 CTest 注册的全部测试。",
      "configurePreset": "ninja-msvc-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ninja-msvc-asan",
      "displayName": "Ninja + MSVC AddressSanitizer Tests",
      "description": "在 AddressSanitizer 配置下运行全部测试。",
      "configurePreset": "ninja-msvc-asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
