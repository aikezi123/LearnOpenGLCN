{
  "version": 3,
  "configurePresets": [
    {
      "name": "ninja-msvc-debug",
      "displayName": "Ninja + MSVC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "ninja-msvc-release",
      "displayName": "Ninja + MSVC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "ninja-msvc-asan",
      "displayName": "Ninja + MSVC AddressSanitizer",
      "inherits": "ninja-msvc-debug",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "LEARNOPENGL_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-msvc-debug",
      "configurePreset": "ninja-msvc-debug"
    },
    {
      "name": "ninja-msvc-release",
      "configurePreset": "ninja-msvc-release"
    },
    {
      "name": "ninja-msvc-asan",
      "configurePreset": "ninja-msvc-asan"
    }
  ]
}
