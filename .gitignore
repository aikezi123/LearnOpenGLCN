# =========================
# Build outputs
# =========================
out/**
!out/
!out/build/
!out/build/*/
/build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json

# =========================
# CMake user/local presets
# =========================
CMakeUserPresets.json

# =========================
# VSCode local settings
# =========================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# 如果 settings.json 里有个人路径，也改成忽略：
# .vscode/settings.json

# =========================
# Visual Studio files
# =========================
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# =========================
# Compiled binaries
# =========================
*.exe
*.dll
*.lib
*.obj
*.pdb
*.ilk
*.exp

# =========================
# Runtime bin artifacts
# =========================
# Only keep runnable artifacts from out/build/<preset>/bin.
# CMake/Ninja intermediate files, .obj, .lib and .ilk stay ignored.
!out/build/*/bin/
!out/build/*/bin/**/
!out/build/*/bin/*.exe
!out/build/*/bin/*.dll
!out/build/*/bin/*.pdb
!out/build/*/bin/**/*.exe
!out/build/*/bin/**/*.dll
!out/build/*/bin/**/*.pdb

# =========================
# Logs
# =========================
*.log

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db
desktop.ini
